---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	lastUpdated?: string;
}

const { title, description = "আব্দুল্লাহ আল মাহমুদের ব্যক্তিগত ওয়েবসাইট। লেখক, শিক্ষক, ব্যবসায়ী এবং দাঈ ইলাল্লাহ।", lastUpdated } = Astro.props;
---

<!doctype html>
<html lang="bn">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/assets/home.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/assets/almahmudbd.png" />
		<meta property="og:type" content="website" />

		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" />
		
		<script is:inline>
			(function () {
				const theme = localStorage.getItem('theme') || 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<Header />
		<main class="page">
			<div class="container">
				<slot />
				{lastUpdated && <div class="last-updated">সর্বশেষ আপডেট: {lastUpdated}</div>}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style is:global>
	/* Any additional global styles that aren't in global.css */
</style>
