---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	lastUpdated?: string;
}

const { title, description = "আব্দুল্লাহ আল মাহমুদের ব্যক্তিগত ওয়েবসাইট। লেখক, শিক্ষক, ব্যবসায়ী এবং দাঈ ইলাল্লাহ।", lastUpdated } = Astro.props;
---

<!doctype html>
<html lang="bn">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/assets/home.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/assets/almahmudbd.png" />
		<meta property="og:type" content="website" />

		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" />
		
		<script is:inline>
			(function () {
				const theme = localStorage.getItem('theme') || 'light';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
	</head>
	<body>
		<Header />
		<main class="page">
			<div class="container">
				<slot />
				{lastUpdated && <div class="last-updated">সর্বশেষ আপডেট: {lastUpdated}</div>}
			</div>
		</main>
		<Footer />

		<script>
			// Scroll Reveal Animation Script
			document.addEventListener('DOMContentLoaded', () => {
				const observerOptions = {
					root: null,
					rootMargin: '0px 0px -40px 0px',
					threshold: 0.05
				};

				const observer = new IntersectionObserver((entries, obs) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('revealed');
							obs.unobserve(entry.target);
						}
					});
				}, observerOptions);

				// Target elements to apply scroll reveal animation
				const revealTargets = document.querySelectorAll(
					'.page-heading, .page-sub, .notice-box, .section-label, .card, .project-card, .course-card, .book-card-wrap, .platform-card, .activism-card, .cta-box, .online-box, .syllabus-grid, .faq-item, .shops-grid, .social-mini-grid, .divider'
				);

				revealTargets.forEach(target => {
					target.classList.add('reveal');
					observer.observe(target);
				});
			});
		</script>
	</body>
</html>

<style is:global>
	/* Any additional global styles that aren't in global.css */
</style>
