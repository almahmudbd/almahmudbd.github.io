---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Homepage — almahmud.pro.bd"
  lastUpdated="১৩ মে ২০২৬"
>
  <section class="hero" aria-label="পরিচিতি">
    <div class="hero-text">
      <p class="page-tag">লেখক · শিক্ষক · ব্যবসায়ী · দাঈ ·</p>
      <h1 class="hero-name">আব্দুল্লাহ আল মাহমুদ</h1>
      <p class="hero-bio">
        জীবন, সমাজ ও আধ্যাত্মিক চিকিৎসা নিয়ে নিয়মিত কথা বলি। রুকইয়াহ শারইয়াহ বিষয়ে
        লেখালেখি ও শিক্ষাদান করি। মাঝে মাঝে কিছু কোডিং, ডিজাইন ও অনুবাদ করি। প্রকৃতি, পরিবার ও নির্জনতা ভালোবাসি।
      </p>
    </div>
    <div class="avatar" aria-hidden="true">
      <span style="font-family:var(--font-serif);font-size:30px;font-weight:500;color:var(--color-text-secondary)">আ</span>
    </div>
  </section>

  <p class="section-label">আমার কাজ</p>
  <div class="card-grid mb-3">
    <a class="card featured" href="/blog" style="display:block;text-decoration:none;">
      <div style="font-size:24px;color:var(--color-text-secondary);margin-bottom:.75rem">
        <i class="ti ti-pencil" aria-hidden="true"></i>
      </div>
      <div class="font-medium" style="font-size:15px;margin-bottom:.35rem">ব্লগ ও সোশ্যাল মিডিয়া</div>
      <div class="text-muted text-sm" style="line-height:1.5;margin-bottom:.75rem">
        আমার প্রোফাইল, ব্লগ, প্রবন্ধের লিংক।
      </div>
      <div class="text-hint text-sm flex items-center gap-8">
        <i class="ti ti-arrow-right" aria-hidden="true"></i> পড়ুন
      </div>
    </a>

    <a class="card" href="/books" style="display:block;text-decoration:none;">
      <div style="font-size:24px;color:var(--color-text-secondary);margin-bottom:.75rem">
        <i class="ti ti-book-2" aria-hidden="true"></i>
      </div>
      <div class="font-medium" style="font-size:15px;margin-bottom:.35rem">বই</div>
      <div class="text-muted text-sm" style="line-height:1.5;margin-bottom:.75rem">
        আমার প্রকাশিত বইয়ের তালিকা ও তথ্য।
      </div>
      <div class="text-hint text-sm flex items-center gap-8">
        <i class="ti ti-arrow-right" aria-hidden="true"></i> দেখুন
      </div>
    </a>

    <a class="card" href="/courses" style="display:block;text-decoration:none;">
      <div style="font-size:24px;color:var(--color-text-secondary);margin-bottom:.75rem">
        <i class="ti ti-school" aria-hidden="true"></i>
      </div>
      <div class="font-medium" style="font-size:15px;margin-bottom:.35rem">কোর্স</div>
      <div class="text-muted text-sm" style="line-height:1.5;margin-bottom:.75rem">
        আমার ক্লাস এবং কোর্স সংক্রান্ত তথ্য।
      </div>
      <div class="text-hint text-sm flex items-center gap-8">
        <i class="ti ti-arrow-right" aria-hidden="true"></i> দেখুন
      </div>
    </a>

    <a class="card" href="/projects" style="display:block;text-decoration:none;">
      <div style="font-size:24px;color:var(--color-text-secondary);margin-bottom:.75rem">
        <i class="ti ti-building-store" aria-hidden="true"></i>
      </div>
      <div class="font-medium" style="font-size:15px;margin-bottom:.35rem">ব্যবসা ও প্রজেক্ট</div>
      <div class="text-muted text-sm" style="line-height:1.5;margin-bottom:.75rem">
        ব্যবসা প্রতিষ্ঠান ও বিভিন্ন প্রজেক্টের তথ্য।
      </div>
      <div class="text-hint text-sm flex items-center gap-8">
        <i class="ti ti-arrow-right" aria-hidden="true"></i> এক্সপ্লোর করুন
      </div>
    </a>

    <a class="card" href="/ruqyah" style="display:block;text-decoration:none;">
      <div style="font-size:24px;color:var(--color-text-secondary);margin-bottom:.75rem">
        <i class="ti ti-heart-handshake" aria-hidden="true"></i>
      </div>
      <div class="font-medium" style="font-size:15px;margin-bottom:.35rem">রুকইয়াহ</div>
      <div class="text-muted text-sm" style="line-height:1.5;margin-bottom:.75rem">
        কমিউনিটি লিংক, লেকচার ও রিসোর্স।
      </div>
      <div class="text-hint text-sm flex items-center gap-8">
        <i class="ti ti-arrow-right" aria-hidden="true"></i> দেখুন
      </div>
    </a>

    <a class="card featured" href="/consulting" style="display:block;text-decoration:none;">
      <div style="font-size:24px;color:var(--color-text-secondary);margin-bottom:.75rem">
        <i class="ti ti-calendar-event" aria-hidden="true"></i>
      </div>
      <div class="font-medium" style="font-size:15px;margin-bottom:.35rem">এপয়েন্টমেন্ট দরকার?</div>
      <div class="text-muted text-sm" style="line-height:1.5;margin-bottom:.75rem">
        রুকইয়াহ এবং পরামর্শের জন্য যোগাযোগের তথ্য।
      </div>
      <div class="text-hint text-sm flex items-center gap-8">
        <i class="ti ti-arrow-right" aria-hidden="true"></i> বিস্তারিত
      </div>
    </a>
  </div>

  <p class="section-label">যোগাযোগ</p>
  <div class="social-mini-grid mb-3">
    <a href="https://facebook.com/almahmud1234" target="_blank" rel="noopener" class="social-mini-card">
      <i class="ti ti-brand-facebook"></i> ফেসবুক ফলো করুন
    </a>
    <a href="mailto:almahmudbd@duck.com" class="social-mini-card">
      <i class="ti ti-mail"></i> ইমেইল করুন
    </a>
    <a href="https://bit.ly/msg2mahmud" target="_blank" rel="noopener" class="social-mini-card">
      <i class="ti ti-message-dots"></i> বেনামে মেসেজ দিন
    </a>
  </div>

  
</Layout>
