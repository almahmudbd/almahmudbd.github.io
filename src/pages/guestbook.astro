---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="গেস্টবুক — almahmud.pro.bd"
  description="আব্দুল্লাহ আল মাহমুদের গেস্টবুক। আপনার মন্তব্য, অনুভূতি বা বার্তা রেখে যান।"
  lastUpdated="০৮ জুন ২০২৬"
>
  <section class="hero" aria-label="গেস্টবুক">
    <div class="hero-text">
      <p class="page-tag">মন্তব্য · বার্তা · অনুভূতি ·</p>
      <h1 class="hero-name">গেস্টবুক</h1>
      <p class="hero-bio">
        আপনার মন্তব্য, পরামর্শ বা অনুভূতি এখানে রেখে যান। প্রতিটি বার্তা আমার কাছে মূল্যবান।
      </p>
    </div>
  </section>

  <!-- Open Remark -->

<div
  data-open-remark
  data-site-key="cmpus3gls000304l73o9a5ojk"
>
</div>

<script is:inline>
  function loadOpenRemark() {
    const oldScript = document.querySelector(
      "script[data-open-remark-script]",
    );
    if (oldScript) oldScript.remove();

    const script = document.createElement("script");
    script.src = "https://open-remark.zeon.studio/embed.js";
    script.async = true;
    script.setAttribute("data-open-remark-script", "true");
    document.body.appendChild(script);
  }

  loadOpenRemark();

  // re-mount on Astro page transitions
  document.addEventListener("astro:page-load", loadOpenRemark);
</script>


  <!-- End Open Remark -->

  <hr class="divider">

  <div class="notice-box">
    <i class="ti ti-bulb notice-icon" aria-hidden="true"></i>
    <div>
      <p class="notice-text">
        <strong>নাম গোপন করে বার্তা দিতে চাচ্ছেন? </strong><br>
        <a href="https://bit.ly/msg2mahmud" target="_blank" rel="noopener" class="btn-p">
          <i class="ti ti-message-dots"></i>তাহলে এখানে ক্লিক করুন
        </a>
      </p>
    </div>
  </div>

</Layout>
