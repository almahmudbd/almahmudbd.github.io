---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="প্রজেক্ট ও ব্যবসা — almahmud" 
  description="আব্দুল্লাহ আল মাহমুদের ব্যবসায়িক উদ্যোগ ও প্রযুক্তি প্রজেক্ট।"
  lastUpdated="১৪ মে ২০২৬"
>
  <p class="page-tag">উদ্যোগ ও প্রযুক্তি</p>
  <h1 class="page-heading">ব্যবসা ও প্রজেক্ট</h1>
  <p class="page-sub">বিভিন্ন সামাজিক ও বাণিজ্যিক উদ্যোগ এবং প্রযুক্তি প্রজেক্টের ওভারভিউ।</p>

  <p class="section-label">ব্যবসায়িক উদ্যোগ</p>

  <div class="project-card">
    <div class="project-header">
      <div class="project-logo"><i class="ti ti-building-store" aria-hidden="true"></i></div>
      <div>
        <div class="project-name"> Sukkar Shop - সুক্কার শপ 
          <span class="badge badge-live" style="vertical-align: middle; margin-left: 6px; font-weight: normal; font-size: 10px; color: var(--color-text-success); background-color: var(--color-background-success); border-color: var(--color-border-success);"> চালু আছে</span>
        </div>
        <div class="project-cat">ই-কমার্স · গ্রোসারি শপ</div>
      </div>
    </div>
    <p class="project-desc">স্বাস্থ্যকর ও হালাল পণ্যের অনলাইন শপ। এখানে উন্নত মানের দেশী-বিদেশি গ্রোসারি পণ্য পাওয়া যায়। সারাদেশে হোম ডেলিভারি দেয়া হয়।</p>
    <div class="project-links">
      <a href="https://sukkarshop.com" target="_blank" rel="noopener" class="btn-p">
        <i class="ti ti-world" aria-hidden="true"></i> sukkarshop.com
      </a>
      <a href="https://www.facebook.com/sukkar.shop" target="_blank" rel="noopener" class="btn-s">
        <i class="ti ti-brand-facebook" aria-hidden="true"></i> Facebook পেজ
      </a>
    </div>
  </div>

  <div class="project-card">
    <div class="project-header">
      <div class="project-logo"><i class="ti ti-shopping-bag" aria-hidden="true"></i></div>
      <div>
        <div class="project-name">Sukkars' Gallery</div>
        <div class="project-cat">ই-কমার্স · লাইফস্টাইল</div>
      </div>
    </div>
    <p class="project-desc">মানসম্মত পোশাক, গৃহস্থালি পণ্য এবং প্রয়োজনীয় ইসলামিক আইটেমের সংগ্রহশালা।</p>
    <div class="project-links">
      <a href="https://www.facebook.com/sukkarsg/" target="_blank" rel="noopener" class="btn-s">
        <i class="ti ti-brand-facebook" aria-hidden="true"></i> Facebook পেজ
      </a>
    </div>
  </div>

  <p class="section-label">প্রযুক্তি ও প্রজেক্ট</p>

  <div class="project-card">
    <div class="project-header">
      <div class="project-logo"><i class="ti ti-tool" aria-hidden="true"></i></div>
      <div>
        <div class="project-name">Online Tools</div>
        <div class="project-cat">ওয়েব এপ্লিকেশন · প্রযুক্তি</div>
      </div>
    </div>
    <p class="project-desc">দৈনন্দিন কাজে প্রয়োজনীয় বিভিন্ন অনলাইন টুলস এবং ওয়েব ইউটিলিটি সাইট।</p>
    <div class="project-links">
      <a href="https://tools.sukkarshop.com" target="_blank" rel="noopener" class="btn-p">
        <i class="ti ti-world" aria-hidden="true"></i> tools.sukkarshop.com
      </a>
    </div>
  </div>

  <div class="project-card">
    <div class="project-header">
      <div class="project-logo"><i class="ti ti-brand-github" aria-hidden="true"></i></div>
      <div>
        <div class="project-name">Programming Projects</div>
        <div class="project-cat">ওপেন সোর্স · প্রযুক্তি</div>
      </div>
    </div>
    <p class="project-desc">আমার বিভিন্ন শখের প্রোগ্রামিং প্রজেক্ট এবং ওপেন সোর্স কোড রিপোজিটরি।</p>
    <div class="project-links">
      <a href="https://github.com/almahmudbd" target="_blank" rel="noopener" class="btn-s">
        <i class="ti ti-brand-github" aria-hidden="true"></i> GitHub প্রোফাইল
      </a>
    </div>
  </div>
</Layout>
